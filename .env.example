# Copy to .env and replace every value. .env is git-ignored — never commit real secrets.

# --- PostgreSQL ---
DB_USER=matcha
DB_PASSWORD=change-me
DB_NAME=matcha

# --- Auth ---
# openssl rand -hex 32
JWT_SECRET=change-me

# --- SMTP (verification + password reset emails) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=matcha@example.com
EMAIL_PASS=change-me

# --- URLs ---
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
